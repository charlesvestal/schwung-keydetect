{
  "title": "Key Detect",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Musical key detection",
        "from incoming audio.",
        "",
        "Analyzes audio in",
        "real-time and",
        "displays the",
        "detected key.",
        "",
        "Pass-through effect",
        "(audio unchanged)."
      ]
    },
    {
      "title": "Controls",
      "lines": [
        "Knob 1: Window",
        " Analysis window",
        " size (1-8 seconds)",
        "",
        "Longer window =",
        "more accurate but",
        "slower response.",
        "",
        "Key is shown in",
        "short form, e.g.",
        "\"C maj\" or \"A min\".",
        "",
        "Sharps are written",
        "as flats: Bb, Db,",
        "Eb, Gb, Ab. 24 keys",
        "in all.",
        "",
        "\"no key\" is shown",
        "until the first",
        "window with audio",
        "in it is analyzed.",
        "It never comes back",
        "once a key is set."
      ]
    }
  ]
}
